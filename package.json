{
  "name": "control-your-skills",
  "version": "2.4.0",
  "private": false,
  "description": "Electron desktop Skill Manager MVP built with Next.js and TypeScript.",
  "main": "dist-electron/main/index.js",
  "author": "KlayPeter",
  "repository": {
    "type": "git",
    "url": "https://github.com/KlayPeter/control-yours-skills.git"
  },
  "homepage": "https://github.com/KlayPeter/control-yours-skills",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "predev": "node scripts/prepare-dev.cjs",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron:build\" \"npm:dev:electron\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3211",
    "dev:electron:build": "tsup electron/main/index.ts electron/preload/index.ts --format cjs --out-dir dist-electron --target node20 --sourcemap --watch --external electron",
    "electron:ensure": "node scripts/ensure-electron.cjs",
    "dev:electron": "npm run electron:ensure && wait-on http-get://127.0.0.1:3211 dist-electron/main/index.js && cross-env NODE_ENV=development ELECTRON_RENDERER_URL=http://127.0.0.1:3211 electron .",
    "build": "npm run build:web && npm run build:electron && npm run build:release",
    "build:web": "next build",
    "build:electron": "tsup electron/main/index.ts electron/preload/index.ts --format cjs --out-dir dist-electron --target node20 --sourcemap --clean --external electron",
    "build:release": "node scripts/prepare-release.cjs",
    "start": "concurrently -k \"npm:start:web\" \"npm:start:electron\"",
    "start:web": "next start -H 127.0.0.1 -p 3211",
    "start:electron": "npm run electron:ensure && wait-on http-get://127.0.0.1:3211 && cross-env NODE_ENV=production ELECTRON_RENDERER_URL=http://127.0.0.1:3211 electron .",
    "lint": "next lint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test": "vitest run",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tailwindcss/typography": "^0.5.16",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^8.0.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.36",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.klaypeter.control-your-skills",
    "productName": "Control Your Skills",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "build/app/**/*",
      "build/app/node_modules/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "build/app/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "build/app/node_modules",
        "to": "app.asar.unpacked/build/app/node_modules"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KlayPeter",
        "repo": "control-yours-skills"
      }
    ]
  }
}
